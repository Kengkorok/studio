# Salin ke .env dan isi. Jangan commit .env.

# GitHub: fine-grained token, repo Kengkorok.github.io sahaja, permission Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=Kengkorok/Kengkorok.github.io
GITHUB_BRANCH=main

SITE_URL=https://korokk.com

# Cloudflare Access (Zero Trust > Access > Applications > studio)
ACCESS_TEAM_DOMAIN=nama-team.cloudflareaccess.com
ACCESS_AUD=
ACCESS_EMAILS=email-kau@contoh.com

# Moderasi komen (Worker workers/komen dalam repo portfolio)
KOMEN_API=https://komen.sa7one.workers.dev
KOMEN_ADMIN_TOKEN=

# Agent AI: penulis:token, dipisah koma. Jana token dengan: openssl rand -hex 32
# claudrok = Claude, korokgpt = ChatGPT. Kosongkan untuk tutup laluan agent.
AGENT_TOKENS=
# Pilihan: webhook Discord untuk notifikasi bila agent hantar draf baru
NOTIFY_WEBHOOK=
# Alamat Studio dalam link yang dipulangkan kepada agent dan connector MCP
STUDIO_URL=https://studio.korokk.com

# Feed: Claude Haiku terjemah dan ringkas berita (console.anthropic.com)
ANTHROPIC_API_KEY=
